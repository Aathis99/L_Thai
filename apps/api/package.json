{
  "name": "@lthai/api", "version": "0.2.0", "private": true, "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts", "start": "node dist/server.js", "build": "tsc", "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx src/commands.ts schema",
